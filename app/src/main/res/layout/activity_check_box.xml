<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="CheckBox"
            android:textColor="#6366F1"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="CheckBox permite seleccionar varias opciones al mismo tiempo."
            android:textColor="#475569"
            android:textSize="16sp" />

        <CheckBox
            android:id="@+id/checkJava"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:text="Java"
            android:textSize="17sp" />

        <CheckBox
            android:id="@+id/checkAndroid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Android"
            android:textSize="17sp" />

        <CheckBox
            android:id="@+id/checkFirebase"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Firebase"
            android:textSize="17sp" />

        <Button
            android:id="@+id/btnConfirmar"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="20dp"
            android:text="Confirmar selección"
            android:textAllCaps="false" />

        <TextView
            android:id="@+id/tvResultado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:padding="20dp"
            android:background="#EEF2FF"
            android:gravity="center"
            android:text="Aquí aparecerán tus selecciones"
            android:textColor="#312E81"
            android:textSize="17sp" />

        <Button
            android:id="@+id/btnVolver"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="25dp"
            android:text="← Volver al Dashboard"
            android:textAllCaps="false" />

    </LinearLayout>

</ScrollView>
